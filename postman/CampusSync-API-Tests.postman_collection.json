          "name": "01 Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Database is connected\", function () { pm.expect(data.status).to.eql(\"ok\"); pm.expect(data.database).to.eql(\"campussync\"); });"
