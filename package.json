{
  "name": "campussync-event-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:server": "node --watch server/server.js",
    "dev:full": "concurrently -n CLIENT,SERVER -c green,cyan \"npm run dev\" \"npm run dev:server\"",
    "build:server": "esbuild server/server.js --bundle --platform=node --format=esm --outfile=dist/boot.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "start": "cross-env NODE_ENV=production node dist/boot.js",
    "seed": "node server/seed.js",
    "test": "node --test --test-concurrency=1 server/tests/*.test.js",
    "check": "tsc -b && node --check server/server.js && node --check server/app.js"
  },
  "dependencies": {
